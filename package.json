{
  "name": "phomymo",
  "version": "1.0.0",
  "description": "A free, browser-based label designer for Phomemo thermal printers. No drivers needed - connects via Bluetooth or USB.",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "python3 -m http.server 8080 --directory src/web",
    "dev:electron": "electron .",
    "test:unit": "node --test tests/node/**/*.test.js",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "manual:screenshots": "npx playwright test",
    "build:electron": "electron-builder --linux AppImage --win portable",
    "build:electron:linux": "electron-builder --linux AppImage",
    "build:electron:win:portable": "electron-builder --win portable",
    "build:electron:win:installer": "electron-builder --win nsis",
    "build:electron:all": "electron-builder --linux AppImage --win portable nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcriptionstream/phomymo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/transcriptionstream/phomymo/issues"
  },
  "homepage": "https://github.com/transcriptionstream/phomymo#readme",
  "dependencies": {
    "puppeteer": "^24.37.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.affordablemagic.phomymo",
    "productName": "Phomymo",
    "files": [
      "src/web/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
